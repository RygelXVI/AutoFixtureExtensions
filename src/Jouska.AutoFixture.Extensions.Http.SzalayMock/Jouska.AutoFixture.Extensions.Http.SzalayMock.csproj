<Project Sdk="Microsoft.NET.Sdk">

		<PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
				<GenerateSBOM>true</GenerateSBOM>
				<EnablePackageValidation>true</EnablePackageValidation>
		</PropertyGroup>
		<ItemGroup>
				<PackageReference Include="AutoFixture" />
				<PackageReference Include="RichardSzalay.MockHttp" />
		</ItemGroup>
		<ItemGroup>
		  <ProjectReference Include="..\Jouska.AutoFixture.Extensions.Http.Helpers\Jouska.AutoFixture.Extensions.Http.Helpers.csproj" />
		</ItemGroup>

    <PropertyGroup>
        <PackageId>Jouska.AutoFixture.Extensions.Http.SzalayMock</PackageId>
        <PackageVersion>1.0.0</PackageVersion>
        <Title>AutoFixture Extensions - Http Szalay Mocking</Title>
        <Description>Helper package for working with AutoFixture and HttpClients using the Richard Szalay HttpMessageHandler mocking library</Description>
        <Authors>Andrew Morshead</Authors>
        <PackageProjectUrl>https://github.com/RygelXVI/AutoFixtureExtensions</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/RygelXVI/AutoFixtureExtensions</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

</Project>
